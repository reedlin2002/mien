{
  "$schema": "../widget.schema.json",
  "id": "repo-pin",
  "name": "Repository card",
  "description": "Show off one of your repositories.",
  "category": "stats",
  "author": "anuraghazra",
  "homepage": "https://github.com/anuraghazra/github-readme-stats",
  "urlTemplate": "https://github-readme-stats.vercel.app/api/pin/?username={username}&repo={repo}&theme={theme}&show_owner={show_owner}&hide_border={hide_border}",
  "linkTemplate": "https://github.com/{username}/{repo}",
  "defaultWidth": 50,
  "aspectRatio": 3.333,
  "params": [
    {
      "key": "username",
      "type": "username"
    },
    {
      "key": "repo",
      "type": "text",
      "label": "Repository",
      "required": true,
      "default": "",
      "placeholder": "my-cool-project"
    },
    {
      "key": "theme",
      "type": "enum",
      "label": "Theme",
      "default": "auto",
      "preview": true,
      "options": [
        {
          "value": "auto",
          "label": "Auto (light/dark)"
        },
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "radical",
          "label": "Radical"
        },
        {
          "value": "tokyonight",
          "label": "Tokyo Night"
        },
        {
          "value": "dracula",
          "label": "Dracula"
        },
        {
          "value": "gruvbox",
          "label": "Gruvbox"
        },
        {
          "value": "onedark",
          "label": "One Dark"
        },
        {
          "value": "synthwave",
          "label": "Synthwave"
        },
        {
          "value": "nord",
          "label": "Nord"
        },
        {
          "value": "catppuccin_mocha",
          "label": "Catppuccin"
        },
        {
          "value": "rose_pine",
          "label": "Rosé Pine"
        }
      ]
    },
    {
      "key": "show_owner",
      "type": "boolean",
      "label": "Show owner",
      "default": false
    },
    {
      "key": "hide_border",
      "type": "boolean",
      "label": "Hide border",
      "default": false
    }
  ],
  "theme": {
    "param": "theme",
    "light": "default",
    "dark": "github_dark"
  }
}

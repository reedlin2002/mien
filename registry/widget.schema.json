{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Widget",
  "description": "A widget in the palette. The editor builds the settings panel from `params`; see CONTRIBUTING.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "author", "homepage", "urlTemplate", "defaultWidth", "aspectRatio", "params"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Must match the file name." },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "description": { "type": "string", "maxLength": 120 },
    "category": { "enum": ["header", "stats", "skills", "badges", "media"] },
    "author": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "pattern": "^https://" },
    "urlTemplate": { "type": "string", "description": "Image URL; {key} is replaced by the URL-encoded value of param `key`." },
    "linkTemplate": { "type": "string", "description": "Where the widget links to on GitHub." },
    "defaultWidth": { "enum": [20, 25, 33, 50, 66, 75, 100, "auto"] },
    "aspectRatio": { "type": "number", "exclusiveMinimum": 0 },
    "params": { "type": "array", "items": { "$ref": "#/definitions/param" } },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["param", "light", "dark"],
      "properties": {
        "param": { "type": "string" },
        "light": { "type": "string" },
        "dark": { "type": "string" }
      }
    }
  },
  "definitions": {
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type"],
      "properties": {
        "key": { "type": "string", "pattern": "^\\w+$" },
        "type": { "enum": ["username", "enum", "multi", "list", "boolean", "color", "number", "text", "url"] },
        "label": { "type": "string" },
        "default": { "type": ["string", "number", "boolean"] },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" },
              "thumbnail": { "type": "string", "pattern": "^https://" },
              "set": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        },
        "preview": { "type": "boolean" },
        "thumbnailTemplate": { "type": "string", "pattern": "^https://" },
        "separator": { "type": "string", "minLength": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["enum", "multi"] } } },
          "then": { "required": ["options"] }
        }
      ]
    }
  }
}
